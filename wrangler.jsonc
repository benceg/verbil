{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "verbil",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "binding": "ASSETS",
    // Unknown paths get a real 404 (from the Worker), not the game page.
    "not_found_handling": "none",
    // Pages and the API go through the Worker (which redirects http to https); hashed
    // bundles and fonts are served straight from the asset store.
    "run_worker_first": ["/*", "!/assets/*", "!/fonts/*"],
  },
  "observability": { "enabled": true },
}
